# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TELEGRAM_BOT_TOKEN: Telegram Bot API token (from @BotFather) for @Q_kormosongsthan_Bangladesh
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# TELEGRAM_ADMIN_CHAT_ID: Primary Admin Numeric Telegram User/Chat ID (e.g., 123456789)
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_ADMIN_CHAT_ID_HERE

# TELEGRAM_FILE_PASSWORD: Password required to unlock and use the Telegram Bot Token & ID file configuration
TELEGRAM_FILE_PASSWORD=YOUR_TELEGRAM_FILE_PASSWORD_HERE

